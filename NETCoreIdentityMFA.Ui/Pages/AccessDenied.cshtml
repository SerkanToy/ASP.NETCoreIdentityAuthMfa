@page
@model NETCoreIdentityMFA.Ui.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Pages/Shared/_LoginLayout.cshtml";
}


<div class="container h-100 d-flex align-items-center justify-content-center">
    <div class="text-center p-4 p-md-5">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 4rem;"></i>
        </div>
        <h1 class="display-1 fw-bold mb-5">403</h1>
        <h2 class="h5 text-muted mb-0">Oops! Access Denied</h2>
        <p class="text-muted mb-4">Welcome to Human Resource Management</p>
        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <a href="/" class="btn btn-primary px-4">
                <i class="bi bi-house-door me-1"></i>
                Back to Dashboard
            </a>
            <a href="#" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i>
                Go Back
            </a>
        </div>
    </div>
</div>