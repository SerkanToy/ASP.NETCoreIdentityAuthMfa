@page "~/calendar"
@model NETCoreIdentityMFA.Ui.Pages.Calendar.CalendarModel
@{
    ViewData["Title"] = "Calendar Page";
    ViewData["ccs"] = "body-layout calendar";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}


@section Css {
    <link rel="stylesheet" href="~/assets/css/vendor/calendar.css">
}

@section Scripts {
    <script src="~/assets/vendor/fullcalendar/index.global.min.js"></script>
    <script src="~/assets/js/apps/app-calendar.js"></script>
}


<main class="app-body border">
    <div class="p-3 p-lg-0">
        <div class="container-fluid px-0">
            <div class="calendar-card d-flex flex-row">
                <nav class="navbar navbar-expand-lg p-0 bg-dark" data-bs-theme="dark">
                    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasBodyMenu">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title">My Calendar</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>
                        <div class="offcanvas-body">
                            <div class="body-sidebar p-3 p-lg-4 d-flex flex-column">
                                <div class="border rounded d-flex mb-3 p-1">
                                    <button class="btn btn-sm rounded py-2 btn-primary btn-ripple flex-grow-1" id="addEventBtn"><i class="bi bi-plus-lg me-1"></i>Add Event</button>
                                    <button class="btn fs-14 btn-link px-2 btn-ripple btn-fullscreen-main d-none d-sm-inline-block" data-bs-toggle="tooltip" data-bs-title="Main App Body Fullscreen"><i class="bi bi-fullscreen"></i></button>
                                </div>
                                <!-- MINI month calendar -->
                                <div class="mt-lg-1" id="miniCalendar"></div>
                                <div class="input-group mb-3 mt-4 border rounded">
                                    <span class="input-group-text border-end-0 bg-transparent border-0 pe-0"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control border-start-0 bg-transparent focus-ring-none border-0" placeholder="Find calendar...">
                                </div>
                                <p class="mb-2 small text-uppercase text-muted">My Calendar</p>
                                <ul class="list-unstyled mb-3 lh-lg mb-lg-auto">
                                    <li><a href="#"><span class="d-inline-flex rounded-circle me-2" style="background:#fb7185; height: 12px; width: 12px;"></span> Work Pla</a></li>
                                    <li><a href="#"><span class="d-inline-flex rounded-circle me-2" style="background:#60a5fa; height: 12px; width: 12px;"></span> Projec</a></li>
                                    <li><a href="#"><span class="d-inline-flex rounded-circle me-2" style="background:#34d399; height: 12px; width: 12px;"></span> Holida</a></li>
                                    <li><a href="#"><span class="d-inline-flex rounded-circle me-2" style="background:#a855f7; height: 12px; width: 12px;"></span> Fitnes</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>
                <div class="body-content p-lg-4" id="calendar"></div>
            </div>
            <!-- Menu toggle fix view only small device -->
            <button class="bg-primary bottom-0 d-lg-none end-0 fs-2 mb-5 me-3 navbar-toggler p-2 position-fixed rounded-circle text-white z-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasBodyMenu" aria-controls="offcanvasMenu" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>
        </div>
    </div>
</main>
