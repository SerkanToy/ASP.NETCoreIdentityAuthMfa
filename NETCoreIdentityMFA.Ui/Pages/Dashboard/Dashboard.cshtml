                                <p class="small mb-1 mt-3">Total Employees</p>
                                <h3 class="h5 mb-0 fw-bold"><span class="counter" data-target="1208">0</span></h3>
                            </div>
                        </div>
                        <!-- New Hires -->
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
                            <div class="card rounded-4 mt-0 p-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M3 21v-2a4 4 0 0 1 4 -4h4c.96 0 1.84 .338 2.53 .901" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /><path d="M16 19h6" /><path d="M19 16v6" /></svg>
                                <p class="small mb-1 mt-3">New Hires</p>
                                <h3 class="h5 mb-0 fw-bold"><span class="counter" data-target="65">0</span></h3>
                            </div>
                        </div>
                        <!-- On Leave Today -->
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
