                                    <div class="d-flex align-items-center gap-2 lh-sm">
                                        <img src="~/assets/images/avatar/avatar-4.png" loading="lazy" class="avatar border border-2 border-white" alt="avatar">
                                        <div>
                                            <h6 class="mb-0 small">Sophia Lee</h6>
