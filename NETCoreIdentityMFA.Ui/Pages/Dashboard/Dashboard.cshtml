@page "~/dashboard"
@model NETCoreIdentityMFA.Ui.Pages.Dashboard.DashboardModel
@{
    ViewData["Title"] = "Dashboard Page";
    //Layout = "~/Pages/Admin/Shared/_LoginLayout.cshtml";
}

@section Css {
    <link rel="stylesheet" href="~/assets/css/vendor/charts.css" />
}

@section Scripts {
    <script src="~/assets/vendor/apexcharts/apexcharts.js"></script>
    <script src="~/assets/js/hr/hr-dashboard.js"></script>
}

<main class="app-body border">
    <!-- page header, Breadcrumb and page action btn -->
    <div class="page-header py-2 py-lg-4 p-lg-4">
        <div class="container-fluid">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div class="align-items-lg-start d-flex flex-column justify-content-center">
                    <h1 class="fs-5 section-title mb-0">HR Insights Dashboard</h1>
                    <h2 class="small text-muted fw-normal">Welcome back to DashQ workspace.</h2>
                </div>
                <div class="d-flex gap-1 align-items-center flex-fill flex-sm-grow-0 border border-secondary-subtle rounded-pill px-2 mt-2 mt-md-0">
                    <input class="form-control fs-14 border-0 bg-transparent rounded-pill js-daterange focus-ring-none" type="text" name="daterange" aria-label="Date Range Filter">
                    <div class="vr"></div>
                    <div class="d-flex gap-1">
                        <button class="btn fs-14 btn-link px-2 btn-ripple" aria-label="Share with"><i class="bi bi-share"></i></button>
                        <button class="btn fs-14 btn-link px-2 btn-ripple" aria-label="PDF Download"><i class="bi bi-filetype-pdf"></i></button>
                        <button class="btn fs-14 btn-link px-2 btn-ripple btn-fullscreen-main d-none d-sm-inline-block" data-bs-toggle="tooltip" data-bs-title="Main App Body Fullscreen" aria-label="Main App Body Fullscreen"><i class="bi bi-fullscreen"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="py-2 py-lg-4 p-lg-4">
        <div class="container-fluid">
            <div class="row g-3">
                <!-- Small card stats -->
                <div class="col-xl-4 col-lg-6 col-md-6">
                    <div class="row g-3">
                        <!-- Total Employees -->
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
