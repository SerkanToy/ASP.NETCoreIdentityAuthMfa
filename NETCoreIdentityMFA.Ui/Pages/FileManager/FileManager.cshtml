            <nav class="navbar navbar-expand-lg p-0">
                <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasBodyMenu">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title">File Manager</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <div class="body-sidebar p-3 d-flex flex-column">
                            <div class="d-flex flex-column gap-3 mb-3">
                                <div class="position-relative">
                                    <img class="avatar avatar-xl border border-2 shadow-sm" src="../assets/images/avatar/avatar-1.png" loading="lazy" alt="User Avatar">
                                    <span class="position-absolute bottom-0 ms-2 start-0 bg-success rounded-circle border border-white" style="width:12px;height:12px;"></span>
                                </div>
                                <div>
                                    <h6 class="fw-semibold mb-0">Advait Patel</h6>
                                    <span class="text-muted small">advait.patel@gmail.com</span>
                                </div>
                            </div>
                            <button class="btn btn-primary rounded-3 w-100 d-flex align-items-center justify-content-center gap-2 btn-ripple"><i class="bi bi-plus-circle"></i>Add New</button>
                            <p class="small text-muted mb-1 mt-3">My Drive</p>
                            <ul class="menu-list list-unstyled lh-lg">
                                <li>
                                    <a class="nav-link d-flex align-items-center gap-2" href="#">
                                        <i class="bi bi-house"></i> Home
                                    </a>
                                </li>
                                <li>
                                    <a class="nav-link d-flex align-items-center gap-2" href="#">
                                        <i class="bi bi-folder"></i> My Files
                                    </a>
                                </li>
                                <li>
                                    <a class="nav-link d-flex align-items-center gap-2" href="#">
                                        <i class="bi bi-share"></i> Shared Files
                                    </a>
                                </li>
                                <li>
                                    <a class="nav-link d-flex align-items-center gap-2" href="#">
                                        <i class="bi bi-star"></i> Starred
                                    </a>
                                </li>
                                <li>
                                    <a class="nav-link d-flex align-items-center gap-2" href="#">
                                        <i class="bi bi-trash"></i> Trash
                                    </a>
                                </li>
                            </ul>
