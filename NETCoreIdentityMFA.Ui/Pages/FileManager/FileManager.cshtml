@page "~/filemanager"
@model NETCoreIdentityMFA.Ui.Pages.FileManager.FileManagerModel

@{
    ViewData["Title"] = "File Manager Page";
    ViewData["ccs"] = "body-layout md";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Css {
    <link rel="stylesheet" href="~/assets/vendor/datatables/jquery.dataTables.min.css">
    <link rel="stylesheet" href="~/assets/vendor/datatables/dataTables.responsive.css">
    <link rel="stylesheet" href="~/assets/css/vendor/datatable.css">
}

@section Scripts {
    <script src="~/assets/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables/dataTables.responsive.js"></script>
    <script src="~/assets/js/datatable-page.js"></script>
}


<main class="app-body border">
