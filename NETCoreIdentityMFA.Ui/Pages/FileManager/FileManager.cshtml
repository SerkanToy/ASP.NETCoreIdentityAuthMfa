                            <div class="card rounded-4">
                                <div class="card-body p-lg-4">
                                    <h6 class="fw-semibold">Need More Space?</h6>
                                    <p class="text-muted small mb-3">Get more storage by upgrading your plan.</p>
                                    <button class="btn btn-primary rounded-3 w-100 btn-ripple">Upgrade Plan</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
