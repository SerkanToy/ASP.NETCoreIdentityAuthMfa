                                <td>$29.00</td>
                                <td><span class="badge bg-success-subtle text-success">Paid</span></td>
                                <td class="text-end">
                                    <button class="btn btn-ripple btn-sm"><i class="bi bi-download"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>01 Mar 2025</td>
                                <td>Pro Plan - Monthly</td>
                                <td>$29.00</td>
                                <td><span class="badge bg-success-subtle text-success">Paid</span></td>
                                <td class="text-end">
                                    <button class="btn btn-ripple btn-sm"><i class="bi bi-download"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>01 Feb 2025</td>
                                <td>Pro Plan - Monthly</td>
                                <td>$29.00</td>
                                <td><span class="badge bg-danger-subtle text-danger">Failed</span></td>
                                <td class="text-end">
                                    <button class="btn btn-ripple text-danger btn-sm"><i class="bi bi-exclamation-circle"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>01 Jan 2025</td>
                                <td>Starter Plan - Monthly</td>
                                <td>$9.00</td>
                                <td><span class="badge bg-success-subtle text-success">Paid</span></td>
                                <td class="text-end">
                                    <button class="btn btn-ripple btn-sm"><i class="bi bi-download"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Setting: notification -->
            <div class="tab-pane fade" id="Setting_notification" role="tabpanel" aria-labelledby="Setting_notification" tabindex="0">
                <h6 class="mb-3 small text-uppercase fw-semibold">Recent Devices</h6>
                <p class="text-muted small mb-4">Choose how you want to receive notifications</p>
                <div class="table-responsive">
                    <table class="table card-table cellsspacing small align-middle mb-0 w-100 nowrap">
