@page "~/myaccount"
@model NETCoreIdentityMFA.Ui.Pages.MyAccount.MyAccountModel
@{
    ViewData["Title"] = "My Account Page";
    ViewData["ccs"] = "";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Css {

}

@section Scripts {

}


<main class="app-body border">
    <div class="user-profile">
        <div class="user-cover-image overflow-hidden rounded-4 border-bottom app-border border-4" style="height: 180px; background: url('/assets/images/profile-cover-image.png') center/cover;"></div>
        <div class="d-flex align-items-center justify-content-between gap-3 px-3 px-lg-4">
            <!-- user avatar -->
            <div style="margin-top: -60px;" class="avatar avatar-xxl border app-border border-5 overflow-visible position-relative shadow">
                <img src="~/assets/images/avatar/avatar-1.png" class="rounded-circle img-fluid" alt="user avatar">
                <svg class="border border-3 bottom-0 end-0 me-3 position-absolute rounded-circle" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="8" cy="8" r="8" fill="var(--bs-success)" />
                </svg>
            </div>
            <div class="user-action d-flex flex-wrap align-items-center justify-content-end gap-1 gap-lg-2 mt-2 mt-lg-3">
                <div class="rounded-pill border px-2 py-1 bg-body">
                    <div class="form-check form-switch mb-0 mx-1">
                        <input class="form-check-input" type="checkbox" role="switch" id="Onlineformessages">
                        <label class="form-check-label small" for="Onlineformessages">Online for messages </label>
                    </div>
                </div>
                <a href="my-profile.html" class="btn btn-sm btn-primary px-3 rounded-pill btn-ripple">Save Changes</a>
            </div>
        </div>
        <div class="p-3 p-lg-4">
            <div class="row g-3">
                <div class="col-lg-6">
                    <h3 class="fw-bold mb-0">Advait Patel</h3>
                    <p class="mb-0">advait.patel@gmail.com</p>
                </div>
                <div class="col-lg-6">
                    <div class="d-flex flex-wrap gap-3 gap-lg-4 justify-content-lg-end">
                        <div class="d-flex align-items-center gap-3 border-start ps-3">
                            <i class="bi bi-briefcase fs-4"></i>
                            <div>
                                <h6 class="mb-0 small lh-1">10+ year job</h6>
                                <span class="fs-12">Experience</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 border-start ps-3">
                            <i class="bi bi-trophy fs-4"></i>
                            <div>
                                <h6 class="mb-0 small lh-1">7 Certificate</h6>
                                <span class="fs-12">Achievement</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 border-start ps-3">
                            <i class="bi bi-hand-thumbs-up fs-4"></i>
                            <div>
                                <h6 class="mb-0 small lh-1">3 Unternship</h6>
                                <span class="fs-12">Completion</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <span class="text-muted small">I specialize in guiding organizations through rebranding projects, improving their design systems, and strengthening their customer-facing communication. My focus is on creating visually consistent, scalable, and user-friendly brand experiences. <a href="#">More</a> </span>
                </div>
            </div>
        </div>
        <!-- User tab -->
        <ul class="flex-nowrap fs-4 gap-4 nav nav-underline overflow-x-auto px-3 px-lg-4 text-nowrap z-1 border-bottom tab-text-gradient" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link nav-link px-0 fw-bold bg-transparent active" data-bs-toggle="tab" data-bs-target="#Setting_account" type="button" role="tab" aria-controls="Setting_account" aria-selected="true">Account Settings</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link nav-link px-0 fw-bold bg-transparent" data-bs-toggle="tab" data-bs-target="#Setting_security" type="button" role="tab" aria-controls="Setting_security" aria-selected="false">Security</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link nav-link px-0 fw-bold bg-transparent" data-bs-toggle="tab" data-bs-target="#Setting_billing" type="button" role="tab" aria-controls="Setting_billing" aria-selected="false">Billing & Plans</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link nav-link px-0 fw-bold bg-transparent" data-bs-toggle="tab" data-bs-target="#Setting_notification" type="button" role="tab" aria-controls="Setting_notification" aria-selected="false">Notification</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link nav-link px-0 fw-bold bg-transparent" data-bs-toggle="tab" data-bs-target="#Setting_connection" type="button" role="tab" aria-controls="Setting_connection" aria-selected="false">Connection</button>
            </li>
        </ul>
        <div class="tab-content p-3 p-lg-4">
            <!-- Setting: account -->
            <div class="tab-pane fade show active" id="Setting_account" role="tabpanel" aria-labelledby="Setting_account" tabindex="0">
