                <h6 class="mb-3 small text-uppercase fw-semibold">Create API Key</h6>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <input class="form-control" placeholder="API key name">
                    </div>
                    <div class="col-md-4">
                        <select class="form-select">
                            <option>Full Access</option>
                            <option>Read Only</option>
                            <option>Restricted</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100 btn-ripple">Generate</button>
                    </div>
                </div>
                <hr class="border-dashed my-lg-5 my-3">
                <!-- API KEY LIST -->
                <h6 class="mb-3 small text-uppercase fw-semibold">API Keys & Access</h6>
                <div class="table-responsive mb-4">
                    <table class="table card-table text-nowrap cellsspacing small align-middle mb-0 w-100 nowrap">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Key</th>
                                <th>Permission</th>
                                <th>Last Used</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Production Key</td>
                                <td><code>sk_live_****9dF3</code></td>
                                <td><span class="badge bg-success-subtle text-success">Full</span></td>
                                <td>Today</td>
                                <td class="text-end">
                                    <button class="btn border-0 btn-ripple btn-sm"><i class="bi bi-clipboard"></i></button>
                                    <button class="btn border-0 btn-ripple btn-sm text-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>Staging Key</td>
                                <td><code>sk_test_****8A1B</code></td>
                                <td><span class="badge bg-warning-subtle text-warning">Read</span></td>
                                <td>3 days ago</td>
                                <td class="text-end">
                                    <button class="btn border-0 btn-ripple btn-sm"><i class="bi bi-clipboard"></i></button>
                                    <button class="btn border-0 btn-ripple btn-sm text-danger"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <hr class="border-dashed my-lg-5 my-3">
                <!-- RECENT DEVICES -->
                <h6 class="mb-3 small text-uppercase fw-semibold">Recent Devices</h6>
                <div class="table-responsive">
                    <table class="table card-table text-nowrap cellsspacing small align-middle mb-0 w-100 nowrap">
                        <thead>
                            <tr>
                                <th>Device</th>
                                <th>Location</th>
                                <th>Last Active</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-laptop fs-4 text-muted"></i>
                                        <div>
                                            <h6 class="fw-semibold mb-0">MacBook Pro</h6>
                                            <span class="small text-muted">Chrome · macOS</span>
                                        </div>
                                    </div>
                                </td>
                                <td>New York, USA</td>
                                <td class="text-success">Active now</td>
                                <td class="text-end">
                                    <span class="badge bg-success-subtle text-success">Current</span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-phone fs-4 text-muted"></i>
                                        <div>
                                            <h6 class="fw-semibold mb-0">iPhone 14</h6>
                                            <span class="small text-muted">Safari · iOS</span>
                                        </div>
                                    </div>
                                </td>
                                <td>Chicago, USA</td>
                                <td>2 hours ago</td>
                                <td class="text-end">
                                    <button class="btn rounded-pill btn-danger btn-sm btn-ripple">Log out</button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-pc-display fs-4 text-muted"></i>
                                        <div>
                                            <h6 class="fw-semibold mb-0">Windows PC</h6>
                                            <span class="small text-muted">Edge · Windows</span>
                                        </div>
                                    </div>
                                </td>
                                <td>London, UK</td>
                                <td>Yesterday</td>
                                <td class="text-end">
                                    <button class="btn rounded-pill btn-danger btn-sm btn-ripple">Log out</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-end mt-3">
                    <button class="btn btn-outline-danger rounded-pill btn-ripple px-3">Log out from all devices</button>
                </div>
            </div>
            <!-- Setting: billing -->
            <div class="tab-pane fade" id="Setting_billing" role="tabpanel" aria-labelledby="Setting_billing" tabindex="0">
                <div class="card rounded-4 border mt-0 mb-4">
                    <div class="card-body p-lg-4">
                        <h6 class="mb-3 small text-uppercase fw-semibold">Current Plan</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="border rounded-4 bg-dark text-white p-3 h-100">
                                    <h5 class="mb-1">Pro Plan</h5>
                                    <p class="small mb-2">$29 / month</p>
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                </div>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <button class="btn rounded-pill btn-ripple btn-outline-primary me-2">Change Plan</button>
                                <button class="btn rounded-pill btn-ripple btn-outline-danger">Cancel Plan</button>
                            </div>
                        </div>
                    </div>
                </div>
                <h6 class="mb-3 small text-uppercase fw-semibold">Payment Methods</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="bg-primary-subtle rounded-4 p-3 p-lg-4 d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-credit-card me-2"></i>
                                **** **** **** 4242
