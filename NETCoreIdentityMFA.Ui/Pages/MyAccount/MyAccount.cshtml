                    </div>
                </div>
                <hr class="border-dashed my-lg-5 my-3">
                <h6 class="mb-3 small text-uppercase fw-semibold">Billing Address</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="companyName" placeholder=" " value="Techlabs Inc">
                            <label for="companyName">Company name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="taxId" placeholder=" ">
                            <label for="taxId">Tax ID / VAT</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="streetAddress" placeholder=" " value="123 Market Street">
                            <label for="streetAddress">Street address</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="city" placeholder=" " value="San Francisco">
                            <label for="city">City</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="state" placeholder=" " value="CA">
                            <label for="state">State</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="zip" placeholder=" " value="94105">
                            <label for="zip">Zip Code</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <select class="form-select" id="Select_country" aria-label="Country">
                                <option selected>United States</option>
                                <option>India</option>
                                <option>United Kingdom</option>
                            </select>
                            <label for="country">Country</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-ripple px-3 rounded-pill btn-primary">Save Address</button>
                    </div>
                </div>
                <hr class="border-dashed my-lg-5 my-3">
                <h6 class="mb-3 small text-uppercase fw-semibold">Billing History</h6>
                <div class="table-responsive">
                    <table class="table card-table text-nowrap cellsspacing small align-middle mb-0 w-100 nowrap">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
