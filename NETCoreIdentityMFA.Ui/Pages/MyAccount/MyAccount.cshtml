                    <!-- Avatar section (unchanged) -->
                    <div class="col-12">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <img class="avatar avatar-xl shadow" src="~/assets/images/avatar/avatar-1.png" loading="lazy" alt="avatar image">
                            <div>
                                <button class="btn btn-ripple rounded-pill px-3 btn-primary btn-sm me-2">Upload new photo</button>
                                <button class="btn btn-ripple rounded-pill px-3 btn-light btn-sm">Reset</button>
                                <p class="small text-muted mt-2 mb-0">Allowed JPG, PNG. Max size 800KB</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="firstName" placeholder=" " value="Advait">
                            <label for="firstName">First Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="lastName" placeholder=" " value="Patel">
                            <label for="lastName">Last Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="email" class="form-control" id="email" placeholder=" " value="Advait@company.com">
                            <label for="email">Email</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="organization" placeholder=" " value="Techlabs">
                            <label for="organization">Organization</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="phone" placeholder=" " value="+1 415 234 9988">
                            <label for="phone">Phone</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="address" placeholder=" ">
