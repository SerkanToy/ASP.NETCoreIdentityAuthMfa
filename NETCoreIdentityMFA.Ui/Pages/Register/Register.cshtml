@page "~/register"
@model NETCoreIdentityMFA.Ui.Pages.Register.RegisterModel
@{
    ViewData["Title"] = "Register Page";
    Layout = "~/Pages/Shared/_LoginLayout.cshtml";
}


<div class="container h-100">
    <!-- Centered Signup Form -->
    <div class="col-12 d-flex align-items-center justify-content-center h-100">
        <div class="card p-lg-5 p-4 rounded-5">
            <!-- Heading -->
            <div class="mb-4">
                <h1 class="auth-title">Create Account ✨</h1>
                <h2 class="h6 text-muted mb-0">Start building powerful dashboards today.</h2>
            </div>
            <!-- Social Buttons -->
            <div class="d-flex flex-column flex-sm-row gap-2 mb-3">
                <button class="btn btn-outline-secondary btn-ripple w-100">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="" width="20" class="me-1">
                    Google
                </button>
                <button class="btn btn-outline-secondary btn-ripple w-100">
                    <i class="bi bi-github me-1"></i> GitHub
                </button>
            </div>
            <div class="mb-3 text-center">
                <div class="divider-text">or</div>
            </div>

            <!-- Signup Form -->
            <form>
                <!-- Full Name -->
                <div class="mb-3">
                    <label for="fullname" class="form-label small text-muted mb-1">Full Name</label>
                    <input type="text" id="fullname" class="form-control" placeholder="John Carter">
                </div>
                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label small text-muted mb-1">Email</label>
                    <input type="email" id="email" class="form-control" placeholder="you@example.com">
                </div>
                <!-- Password -->
                <div class="mb-3">
                    <label for="password" class="form-label small text-muted mb-1">Password</label>
                    <input type="password" id="password" class="form-control" placeholder="At least 8 characters">
                </div>
                <!-- Confirm Password -->
                <div class="mb-3">
                    <label for="confirmPassword" class="form-label small text-muted mb-1">Confirm Password</label>
                    <input type="password" id="confirmPassword" class="form-control" placeholder="Re-enter password">
                </div>
                <!-- Terms -->
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" value="" id="termsCheck">
                    <label class="form-check-label small text-muted" for="termsCheck">
                        I agree to the <a href="#" class="text-primary text-decoration-none">Terms & Conditions</a>.
                    </label>
                </div>
                <!-- Submit -->
                <div class="d-grid mb-3">
                    <a href="index.html" class="btn btn-primary">Create Account</a>
                </div>
            </form>
            <p class="small text-muted mt-3 mb-0">
                Already have an account?
                <a href="/login" class="text-primary text-decoration-none fw-semibold">Login</a>
            </p>
        </div>
    </div>
</div>