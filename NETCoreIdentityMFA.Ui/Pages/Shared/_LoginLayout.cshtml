<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="~/assets/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/assets/vendor/daterangepicker/daterangepicker.css" />

    <link rel="stylesheet" href="~/assets/css/styles.css" />
    <link rel="stylesheet" href="~/assets/css/layout-main.css" />
    <link rel="stylesheet" href="~/assets/css/vendor/charts.css" />
</head>
<body class="layout-main h-100">
    @RenderBody()

   
    <button class="btn icon-button border-0 py-2 px-3 position-fixed z-1 bottom-0 end-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#setting_drawer">
        <i class="bi bi-gear"></i>
    </button>

    <!-- offcanvas: Theme Settings -->
    <div class="offcanvas m-md-4 rounded-4 offcanvas-end" tabindex="-1" id="setting_drawer">
        <div class="offcanvas-header bg-body-secondary rounded-top-4 px-lg-4">
            <p class="offcanvas-title fs-6">Theme Settings</p>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-lg-4">
            <p class="small text-muted mb-1 text-uppercase">Theme presets</p>
            <ul class="theme-swatches list-unstyled d-flex gap-1 align-items-center">
                <li class="theme-swatch rounded-circle" data-theme="theme-purple" style="background:#7c3aed;"></li>
                <li class="theme-swatch rounded-circle" data-theme="theme-indigo" style="background:#4f46e5;"></li>
                <li class="theme-swatch rounded-circle" data-theme="theme-sky" style="background:#378aff;"></li>
                <li class="theme-swatch rounded-circle" data-theme="theme-emerald" style="background:#4dcf7d;"></li>
                <li class="theme-swatch rounded-circle" data-theme="theme-rose" style="background:#f43f5e;"></li>
                <li class="theme-swatch rounded-circle" data-theme="theme-orange" style="background:#fa8738;"></li>
                <li class="theme-swatch rounded-circle" data-theme="theme-slate" style="background:#475569;"></li>
                <li class="theme-swatch rounded-circle" data-theme="theme-mocha" style="background:#7b4a2e;"></li>
                <li class="theme-swatch rounded-circle" data-theme="theme-mustard" style="background:#ca8a04;"></li>
            </ul>
            <p class="small text-muted mb-1 mt-xl-4 mt-4 text-uppercase">Custom color</p>
            <div class="d-flex align-items-center justify-content-between gap-2 custom-color-row mb-2 border rounded-pill px-2 py-1">
                <input type="color" id="customThemeColor" class="form-control border-0 form-control-color bg-transparent avatar avatar-sm p-0" value="#4f46e5">
                <input type="text" id="customThemeHex" class="form-control focus-ring-none border-0 form-control-sm hex-input bg-transparent p-0" value="#4f46e5">
            </div>
            <ul class="list-unstyled mt-3 mb-4 setting-switch-toggle">
                <li class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="Background_Image" checked>
                    <label class="form-check-label" for="Background_Image">Background Image</label>
                </li>
                <li class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="Glass_Effect_Toggle" checked>
                    <label class="form-check-label" for="Glass_Effect_Toggle">Glass Effect</label>
                </li>
                <li class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="Retro_Border_Style">
                    <label class="form-check-label" for="Retro_Border_Style">Retro Style Black Border</label>
                </li>
                <li class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="Classic_View">
                    <label class="form-check-label" for="Classic_View">Classic View</label>
                </li>
                <li class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="RTL_Mode">
                    <label class="form-check-label" for="RTL_Mode">Switch to RTL Mode</label>
                </li>
            </ul>
            <hr class="border-dashed my-2">
            <p class="small text-muted mb-1 mt-xl-4 mt-4 text-uppercase">Font family</p>
            <div class="font-setting d-flex flex-wrap gap-1">
                <button type="button" class="btn btn-sm px-3 btn-outline-secondary rounded-pill font-pill border" data-font="inter" style="font-family:'Inter', system-ui;">Inter</button>
                <button type="button" class="btn btn-sm px-3 btn-outline-secondary rounded-pill font-pill border" data-font="dm" style="font-family:'DM Sans', system-ui;">DM Sans</button>
                <button type="button" class="btn btn-sm px-3 btn-outline-secondary rounded-pill font-pill border" data-font="poppins" style="font-family:'Poppins', system-ui;">Poppins</button>
                <button type="button" class="btn btn-sm px-3 btn-outline-secondary rounded-pill font-pill border" data-font="space" style="font-family:'Space Grotesk', system-ui;">Space Grotesk</button>
            </div>
            <p class="small text-muted mb-1 mt-xl-4 mt-4 text-uppercase">Font size</p>
            <div class="font-size-setting d-flex flex-wrap gap-1">
                <button type="button" class="btn btn-sm px-3 btn-outline-secondary rounded-pill size-pill border" data-size="small">Small</button>
                <button type="button" class="btn btn-sm px-3 btn-outline-secondary rounded-pill size-pill border" data-size="medium">Medium</button>
                <button type="button" class="btn btn-sm px-3 btn-outline-secondary rounded-pill size-pill border" data-size="large">Big</button>
            </div>
        </div>
    </div>

    <script src="~/assets/vendor/jquery/jquery.min.js"></script>
    <script src="~/assets/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/momentjs/moment.min.js"></script>
    <script src="~/assets/vendor/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/assets/vendor/apexcharts/apexcharts.js"></script>
    <script src="~/assets/vendor/sortablejs/sortable.min.js"></script>

    <!-- begin::DashQ App Custom Scripts -->
    <script src="~/assets/js/app.js"></script>

    <!-- begin::DashQ page specific script -->
    <script asp-append-version="true" src="~/assets/js/index.js"></script>
</body>
</html>
